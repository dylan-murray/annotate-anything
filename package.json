{
  "name": "annotate-anything",
  "version": "0.0.0",
  "private": true,
  "description": "Click on any running web app, leave notes, and send them straight to your coding agent.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "vite build && vite build --config vite.iife.config.ts && tsc -p tsconfig.build.json",
    "dev": "vite --config fixture/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && playwright test"
  },
  "devDependencies": {
    "@headlessui/react": "2.2.10",
    "@playwright/test": "1.64.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "astro": "7.4.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "bin": {
    "annotate-anything": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/types/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./middleware": {
      "types": "./dist/types/server/middleware.d.ts",
      "import": "./dist/middleware.js"
    },
    "./script": "./dist/annotate-anything.iife.js",
    "./next": {
      "types": "./dist/types/next.d.ts",
      "import": "./dist/next.js"
    },
    "./next/client": {
      "types": "./dist/types/next-client.d.ts",
      "import": "./dist/next-client.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "agent"
  ],
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  }
}
