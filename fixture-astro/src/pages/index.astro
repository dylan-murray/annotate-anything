---
const title = "Astro page";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body style="margin:0;padding:24px 16px;font:16px/1.5 system-ui,sans-serif">
    <h1 class="title">{title}</h1>
    <p class="lede">Server-rendered by Astro's dev server.</p>
  </body>
</html>
